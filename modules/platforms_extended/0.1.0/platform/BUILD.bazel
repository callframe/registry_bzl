"""Common OS and CPU selector groups."""

load("@bazel_skylib//lib:selects.bzl", "selects")

package(default_visibility = ["//visibility:public"])

selects.config_setting_group(
    name = "x86_unix",
    match_all = [
        "//cpu:x86",
        "//os:unix",
    ],
)

selects.config_setting_group(
    name = "x64_unix",
    match_all = [
        "//cpu:x64",
        "//os:unix",
    ],
)

selects.config_setting_group(
    name = "arm32_unix",
    match_all = [
        "//cpu:arm32",
        "//os:unix",
    ],
)

selects.config_setting_group(
    name = "arm64_unix",
    match_all = [
        "//cpu:arm64",
        "//os:unix",
    ],
)

selects.config_setting_group(
    name = "x86_linux",
    match_all = [
        "//cpu:x86",
        "@platforms//os:linux",
    ],
)

selects.config_setting_group(
