load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load(
    ":config.bzl",
    "SHARED_LIB_LINKOPTS",
    "SHARED_LIB_NAME",
    "generate_config_h",
)

# --- build settings --------------------------------------------------------

string_flag(
    name = "linkage",
    build_setting_default = "dynamic",
    values = [
        "dynamic",
        "static",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "static_linkage",
    flag_values = {":linkage": "static"},
)

# --- generated config ------------------------------------------------------

generate_config_h(
    name = "config_h",
    out = "config.h",
    visibility = ["//src:__pkg__"],
    version = module_version(),
)

cc_library(
    name = "config",
    hdrs = [":config_h"],
    visibility = [
        "//cursor:__pkg__",
        "//src:__pkg__",
    ],
)

# --- shared libraries ------------------------------------------------------

cc_shared_library(
    name = "client_shared",
    shared_lib_name = SHARED_LIB_NAME["client"],
    user_link_flags = SHARED_LIB_LINKOPTS["client"],
    deps = ["//src:client_objects"],
)

cc_shared_library(
    name = "server_shared",
    shared_lib_name = SHARED_LIB_NAME["server"],
    user_link_flags = SHARED_LIB_LINKOPTS["server"],
    deps = ["//src:server_objects"],
)

cc_shared_library(
    name = "cursor_shared",
    dynamic_deps = [":client_shared"],
    shared_lib_name = SHARED_LIB_NAME["cursor"],
    user_link_flags = SHARED_LIB_LINKOPTS["cursor"],
    deps = ["//cursor:objects"],
)

cc_shared_library(
    name = "egl_shared",
    shared_lib_name = SHARED_LIB_NAME["egl"],
    user_link_flags = SHARED_LIB_LINKOPTS["egl"],
    deps = ["//egl:objects"],
)

cc_import(
    name = "client_dynamic",
    shared_library = ":client_shared",
    deps = ["//src:client_headers"],
)

cc_import(
    name = "server_dynamic",
    shared_library = ":server_shared",
    deps = ["//src:server_headers"],
)

cc_import(
    name = "cursor_dynamic",
    shared_library = ":cursor_shared",
    deps = ["//cursor:headers"],
)

cc_import(
    name = "egl_dynamic",
    shared_library = ":egl_shared",
    deps = ["//egl:headers"],
)

# --- public aliases --------------------------------------------------------

alias(
    name = "wayland-client",
    actual = select({
        ":static_linkage": "//src:client_objects",
        "//conditions:default": ":client_dynamic",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "wayland-server",
    actual = select({
        ":static_linkage": "//src:server_objects",
        "//conditions:default": ":server_dynamic",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "wayland-cursor",
    actual = select({
        ":static_linkage": "//cursor:objects",
        "//conditions:default": ":cursor_dynamic",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "wayland-egl",
    actual = select({
        ":static_linkage": "//egl:objects",
        "//conditions:default": ":egl_dynamic",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "wayland-scanner",
    actual = "//src:wayland-scanner",
    visibility = ["//visibility:public"],
)
