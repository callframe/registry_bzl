load("@bazel_skylib//lib:selects.bzl", "selects")
load(
    "@bazel_skylib//rules:common_settings.bzl",
    "bool_flag",
    "int_flag",
    "string_flag",
)
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load(
    ":config.bzl",
    "EXPAT_DEF_BY_ATTR_INFO",
    "EXPAT_DEF_BY_DTD_OR_GE",
    "SHARED_LIB_LINKOPTS",
    "SHARED_LIB_NAME",
    "expat_config",
)

# --- build settings --------------------------------------------------------

bool_flag(
    name = "attr_info",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "large_size",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "min_size",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "dtd",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "ge",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "ns",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

int_flag(
    name = "context_bytes",
    build_setting_default = 1024,
    visibility = ["//visibility:public"],
)

string_flag(
    name = "linkage",
    build_setting_default = "dynamic",
    values = [
        "dynamic",
        "static",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "static_linkage",
    flag_values = {":linkage": "static"},
)

config_setting(
    name = "attr_info_enabled",
    flag_values = {":attr_info": "True"},
)

config_setting(
    name = "dtd_enabled",
    flag_values = {":dtd": "True"},
)

config_setting(
    name = "ge_enabled",
    flag_values = {":ge": "True"},
)

config_setting(
    name = "min_size_enabled",
    flag_values = {":min_size": "True"},
)

config_setting(
    name = "ns_enabled",
    flag_values = {":ns": "True"},
)

selects.config_setting_group(
    name = "cl_compatible_compiler",
    match_any = [
        "@rules_cc//cc/compiler:clang-cl",
        "@rules_cc//cc/compiler:msvc-cl",
    ],
)

# --- generated files -------------------------------------------------------

expat_config(name = "config")

expand_template(
    name = "libexpat_def",
    out = "lib/libexpat.def",
    substitutions = select(EXPAT_DEF_BY_ATTR_INFO) |
                    selects.with_or(EXPAT_DEF_BY_DTD_OR_GE),
    template = "lib/libexpat.def.cmake",
)

# --- library ---------------------------------------------------------------

PUBLIC_HEADERS = [
    "lib/expat.h",
    "lib/expat_external.h",
]

INTERNAL_HEADERS = [
    "lib/ascii.h",
    "lib/asciitab.h",
    "lib/fallthrough.h",
    "lib/iasciitab.h",
    "lib/internal.h",
    "lib/latin1tab.h",
    "lib/memory_sanitizer.h",
    "lib/nametab.h",
    "lib/random_dev_urandom.h",
    "lib/random_rand_s.h",
    "lib/siphash.h",
    "lib/utf8tab.h",
    "lib/winconfig.h",
    "lib/xmlrole.h",
    "lib/xmltok.h",
    "lib/xmltok_impl.h",
]

COMMON_SOURCES = [
    "lib/xmlparse.c",
    "lib/xmlrole.c",
    "lib/xmltok.c",
]

RANDOM_SOURCES_BY_OS = {
    ("@platforms//os:linux", "@platforms//os:macos", "//platforms:bsd"): [
        "lib/random_dev_urandom.c",
    ],
    "@platforms//os:windows": [
        "lib/random_rand_s.c",
    ],
    "//conditions:default": ["@platforms//:incompatible"],
}

TEXTUAL_HEADERS = [
    "lib/xcsinc.c",
    "lib/xmltok_impl.c",
    "lib/xmltok_ns.c",
]

cc_library(
    name = "headers",
    hdrs = PUBLIC_HEADERS,
    defines = select({
        ":static_linkage": ["XML_STATIC"],
        "//conditions:default": [],
    }),
    strip_include_prefix = "/lib",
    visibility = ["//visibility:public"],
    deps = [":config"],
)

cc_library(
    name = "config_header",
    hdrs = ["expat_config.h"],
)

cc_library(
    name = "internal_headers",
    hdrs = INTERNAL_HEADERS,
    strip_include_prefix = "/lib",
    deps = [":config_header"],
)

cc_library(
    name = "objects",
    srcs = COMMON_SOURCES + select(RANDOM_SOURCES_BY_OS),
    copts = select({
        ":cl_compatible_compiler": [
            "/wd4996",
        ],
        "//platforms:gnu_compiler": [
            "-std=c99",
            "-fexceptions",
        ],
        "//conditions:default": [],
    }),
    local_defines = select({
        ":min_size_enabled": ["XML_MIN_SIZE"],
        "//conditions:default": [],
    }) + select({
        ":ns_enabled": ["XML_NS"],
        "//conditions:default": [],
    }),
    textual_hdrs = TEXTUAL_HEADERS,
    deps = [
        ":config",
        ":headers",
    ],
    implementation_deps = [":internal_headers"],
)

cc_shared_library(
    name = "shared",
    shared_lib_name = select(SHARED_LIB_NAME),
    user_link_flags = selects.with_or(SHARED_LIB_LINKOPTS),
    win_def_file = select({
        "@platforms//os:windows": ":libexpat_def",
        "//conditions:default": None,
    }),
    deps = [":objects"],
)

filegroup(
    name = "import_library",
    srcs = [":shared"],
    output_group = "interface_library",
)

cc_import(
    name = "dynamic",
    interface_library = select({
        "@platforms//os:windows": ":import_library",
        "//conditions:default": None,
    }),
    shared_library = ":shared",
    deps = [":headers"],
)

alias(
    name = "libexpat",
    actual = select({
        ":static_linkage": ":objects",
        "//conditions:default": ":dynamic",
    }),
    visibility = ["//visibility:public"],
)
