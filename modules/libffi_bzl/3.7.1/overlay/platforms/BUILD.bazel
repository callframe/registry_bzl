"""The libffi-specific host cases of configure.host, as config settings."""

load("@bazel_skylib//lib:selects.bzl", "selects")

CPU_GROUPS = {
    "x86": [
        "@platforms//cpu:x86_32",
        "@platforms//cpu:i386",
    ],
    "x64": ["@platforms//cpu:x86_64"],
    "arm32": [
        "@platforms//cpu:arm",
        "@platforms//cpu:armv7",
    ],
    "arm64": ["@platforms//cpu:arm64"],
}

OS_GROUPS = {
    "bsd": [
        "@platforms//os:freebsd",
        "@platforms//os:openbsd",
        "@platforms//os:netbsd",
    ],
}

OS_LABELS = {
    "bsd": ":bsd",
    "linux": "@platforms//os:linux",
    "macos": "@platforms//os:macos",
    "windows": "@platforms//os:windows",
}

[selects.config_setting_group(
    name = name,
    match_any = labels,
    visibility = ["//:__pkg__"],
) for name, labels in CPU_GROUPS.items()]

[selects.config_setting_group(
    name = name,
    match_any = labels,
    visibility = ["//:__pkg__"],
) for name, labels in OS_GROUPS.items()]

[selects.config_setting_group(
    name = "%s_%s" % (cpu, os),
    match_all = [
        ":" + cpu,
        OS_LABELS[os],
    ],
    visibility = ["//:__pkg__"],
) for cpu in CPU_GROUPS.keys() for os in OS_LABELS.keys()]

selects.config_setting_group(
    name = "x86_32_not_macos",
    match_any = [
        ":x86_linux",
        ":x86_windows",
        ":x86_bsd",
    ],
    visibility = ["//:__pkg__"],
)

selects.config_setting_group(
    name = "arm32_not_macos",
    match_any = [
        ":arm32_linux",
        ":arm32_windows",
        ":arm32_bsd",
    ],
    visibility = ["//:__pkg__"],
)

# i?86 freebsd and openbsd get their own target; netbsd is not special-cased
# upstream and falls through to i?86-*-*.
selects.config_setting_group(
    name = "x86_freebsd",
    match_all = [
        ":x86_32_not_macos",
        ":freebsd_or_openbsd",
    ],
    visibility = ["//:__pkg__"],
)

selects.config_setting_group(
    name = "freebsd_or_openbsd",
    match_any = [
        "@platforms//os:freebsd",
        "@platforms//os:openbsd",
    ],
    visibility = ["//:__pkg__"],
)

selects.config_setting_group(
    name = "gnu_compiler",
    match_any = [
        "@rules_cc//cc/compiler:gcc",
        "@rules_cc//cc/compiler:clang",
    ],
    visibility = ["//:__pkg__"],
)
